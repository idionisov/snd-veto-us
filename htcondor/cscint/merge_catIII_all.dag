# DAGMan workflow: Merge Partitions (all 40 Cat III runs) -> catIII_<YEAR>.root
JOB RUN_MERGES merge_runs.sub
VARS RUN_MERGES args_file="/afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/cscint/args_merge_catIII_all.txt"

JOB CAT_MERGE merge_category_year.sub
VARS CAT_MERGE year="all"

PARENT RUN_MERGES CHILD CAT_MERGE
