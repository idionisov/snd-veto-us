base_dir                = /afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/cscint
initialdir              = $(base_dir)

executable              = $(base_dir)/merge_categories.sh

output                  = $(base_dir)/out/merge_categories_$(ClusterId).out
error                   = $(base_dir)/err/merge_categories_$(ClusterId).err
log                     = $(base_dir)/log/merge_categories_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "microstep"
