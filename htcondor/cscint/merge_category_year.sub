# ==============================================================================
# HTCondor Submit File: Merge Category ROOT File for a Specific Year
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/cscint
initialdir              = $(base_dir)

year                    = $(year:all)

executable              = $(base_dir)/merge_category_catIII.sh
arguments               = $(year)

output                  = $(base_dir)/out/merge_catIII_$(year)_$(ClusterId).out
error                   = $(base_dir)/err/merge_catIII_$(year)_$(ClusterId).err
log                     = $(base_dir)/log/merge_catIII_$(year)_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "espresso"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

request_cpus            = 4
request_memory          = 4GB
request_disk            = 5GB

queue 1
