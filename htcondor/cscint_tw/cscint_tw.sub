# ==============================================================================
# HTCondor Submit File: Time-Walk Corrected c_scint Extraction per Partition
#
# Process per job: One raw partition file (sndsw_raw-XXXX.root)
# Output: /eos/user/i/idioniso/Timing/cscint_tw_parts/<category>/run<RUN>/part_<PARTITION>.root
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/cscint_tw
initialdir              = $(base_dir)

flavour                 = $(flavour:workday)
args_file               = $(args_file:$(base_dir)/args_partitions_all_max50.txt)
out_base                = $(out_base:/eos/user/i/idioniso/Timing/cscint_tw_parts)
tw_dir                  = $(tw_dir:/eos/user/i/idioniso/Timing/timewalk/fits)

executable              = $(base_dir)/run_cscint_tw_worker.sh
arguments               = $(run) $(partition) $(category) $(out_base) $(tw_dir)
environment             = "FORCE=$(force:0)"

output                  = $(base_dir)/out/cscint_tw_run$(run)_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/cscint_tw_run$(run)_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/cscint_tw_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

request_cpus            = 1
request_memory          = 4GB
request_disk            = 2GB
max_retries             = 2

queue run, partition, category from $(args_file)
