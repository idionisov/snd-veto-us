# ==============================================================================
# HTCondor Submit File: TimeWalk Parameter Drift Study across Runs
#
# Process per job: One full run (5,000,000 events)
# Flavour: workday
# Output: /eos/user/i/idioniso/Timing/run<runNr>/
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/par_drift
initialdir              = $(base_dir)

flavour                 = $(flavour:testmatch)
args_file               = $(args_file:$(base_dir)/args_run_catI.txt)
n_events                = $(n_events:10000000)
out_base                = $(out_base:/eos/user/i/idioniso/Timing)
ref_sys                 = $(ref_sys:0)
speed_events            = $(speed_events:$(n_events))

executable              = $(base_dir)/run_TimeWalk_drift_worker.sh
arguments               = $(run) $(n_events) $(out_base) $(ref_sys) $(speed_events)
environment             = "FORCE=$(force:0)"

output                  = $(base_dir)/out/tw_run$(run)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/tw_run$(run)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/tw_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh, /afs/cern.ch/user/i/idioniso/ddfUtils

request_cpus            = 1
request_memory          = 4GB
request_disk            = 4GB
max_retries             = 2

queue run from $(args_file)
