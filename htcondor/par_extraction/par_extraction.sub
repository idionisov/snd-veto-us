# ==============================================================================
# HTCondor Submit File: TimeWalk Calibration Parameter Extraction (Run 5999)
#
# Process per job:
#   Inputs : 2023 Converted raw physics data (/eos/experiment/sndlhc/convertedData/physics/2023/run_005999)
#   Outputs: raw_histograms_<start>.root in /eos/user/i/idioniso/Timing/run005999/parallel_parts/part_<job_id>/
#
# Usage:
#   condor_submit par_extraction.sub
#   ./submit_pExtr.sh
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/par_extraction
initialdir              = $(base_dir)

flavour                 = $(flavour:workday)
args_file               = $(args_file:$(base_dir)/args_run5999_250jobs.txt)

run                     = $(run:5999)
out_dir                 = $(out_dir:/eos/user/i/idioniso/Timing/run005999)
ref_sys                 = $(ref_sys:0)

executable              = $(base_dir)/run_TimeWalk_worker.sh
arguments               = $(job_id) $(start) $(n_events) $(run) $(out_dir) $(ref_sys)
environment             = "FORCE=$(force:0)"

output                  = $(base_dir)/out/tw_part$(job_id)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/tw_part$(job_id)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/tw_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh, /afs/cern.ch/user/i/idioniso/ddfUtils

request_cpus            = 1
request_memory          = 4GB
request_disk            = 4GB
max_retries             = 2

queue job_id, start, n_events from $(args_file)
