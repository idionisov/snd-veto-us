# ==============================================================================
# HTCondor Submit File: Reference Time Extraction - Category III (2023)
#
# Process per job: One raw partition file (sndsw_raw-XXXX.root)
# 10 qualifying collision runs with most entries in 2023 (2,914 total partition jobs)
# Flavour: longlunch
# Output: /eos/user/i/idioniso/Timing/ref_times_parts/catIII/run<RUN>/part_<PARTITION>.root
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/ref_times
initialdir              = $(base_dir)

flavour                 = $(flavour:longlunch)
args_file               = $(args_file:$(base_dir)/args_partitions_catIII_2023.txt)
out_base                = $(out_base:/eos/user/i/idioniso/Timing/ref_times_parts)

executable              = $(base_dir)/run_ref_times_worker.sh
arguments               = $(run) $(partition) $(category) $(out_base)
environment             = "FORCE=$(force:0)"

output                  = $(base_dir)/out/reft_2023_run$(run)_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/reft_2023_run$(run)_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/reft_2023_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

request_cpus            = 1
request_memory          = 4GB
request_disk            = 2GB
max_retries             = 2

queue run, partition, category from $(args_file)
