# ==============================================================================
# HTCondor DAGMan Workflow: Time-Walk Calibration Pipeline
# Group: All Eras (Cat II 2022 + Cat III 2023-2026)
# Runs : 73 independent run pipelines (Fill -> Merge -> Fit)
# ==============================================================================

CONFIG dagman.config

# --- Run 5119 (catII, 21 partitions) ---
JOB  fill_5119   timewalk.sub
VARS fill_5119   args_file="/afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/timewalk/dag_args/parts_run5119.txt"
RETRY fill_5119  2

JOB  merge_5119  merge_single_run.sub
VARS merge_5119  run="5119" category="catII"
RETRY merge_5119 2

JOB  fit_5119    fit_single_run.sub
VARS fit_5119    run="5119"
RETRY fit_5119   2

PARENT fill_5119 CHILD merge_5119
PARENT merge_5119 CHILD fit_5119

