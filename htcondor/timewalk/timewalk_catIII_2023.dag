# ==============================================================================
# HTCondor DAGMan Workflow: Time-Walk Calibration Pipeline
# Group: Cat III (2023)
# Runs : 10 independent run pipelines (Fill -> Merge -> Fit)
# ==============================================================================

CONFIG dagman.config

# --- Run 6079 (catIII, 50 partitions) ---
JOB  fill_6079   timewalk.sub
VARS fill_6079   args_file="/afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/timewalk/dag_args/parts_run6079.txt"
RETRY fill_6079  2

JOB  merge_6079  merge_single_run.sub
VARS merge_6079  run="6079" category="catIII"
RETRY merge_6079 2

JOB  fit_6079    fit_single_run.sub
VARS fit_6079    run="6079"
RETRY fit_6079   2

PARENT fill_6079 CHILD merge_6079
PARENT merge_6079 CHILD fit_6079

