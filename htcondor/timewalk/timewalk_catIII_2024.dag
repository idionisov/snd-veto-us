# ==============================================================================
# HTCondor DAGMan Workflow: Time-Walk Calibration Pipeline
# Group: Cat III (2024)
# Runs : 10 independent run pipelines (Fill -> Merge -> Fit)
# ==============================================================================

CONFIG dagman.config

# --- Run 8638 (catIII, 50 partitions) ---
JOB  fill_8638   timewalk.sub
VARS fill_8638   args_file="/afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/timewalk/dag_args/parts_run8638.txt"
RETRY fill_8638  2

JOB  merge_8638  merge_single_run.sub
VARS merge_8638  run="8638" category="catIII"
RETRY merge_8638 2

JOB  fit_8638    fit_single_run.sub
VARS fit_8638    run="8638"
RETRY fit_8638   2

PARENT fill_8638 CHILD merge_8638
PARENT merge_8638 CHILD fit_8638

