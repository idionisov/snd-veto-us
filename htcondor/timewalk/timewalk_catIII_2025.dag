# ==============================================================================
# HTCondor DAGMan Workflow: Time-Walk Calibration Pipeline
# Group: Cat III (2025)
# Runs : 10 independent run pipelines (Fill -> Merge -> Fit)
# ==============================================================================

CONFIG dagman.config

# --- Run 11124 (catIII, 50 partitions) ---
JOB  fill_11124   timewalk.sub
VARS fill_11124   args_file="/afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/timewalk/dag_args/parts_run11124.txt"
RETRY fill_11124  2

JOB  merge_11124  merge_single_run.sub
VARS merge_11124  run="11124" category="catIII"
RETRY merge_11124 2

JOB  fit_11124    fit_single_run.sub
VARS fit_11124    run="11124"
RETRY fit_11124   2

PARENT fill_11124 CHILD merge_11124
PARENT merge_11124 CHILD fit_11124

