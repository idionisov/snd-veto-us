# ==============================================================================
# HTCondor DAGMan Workflow: Time-Walk Calibration Pipeline
# Group: Cat III (2026)
# Runs : 10 independent run pipelines (Fill -> Merge -> Fit)
# ==============================================================================

CONFIG dagman.config

# --- Run 13085 (catIII, 50 partitions) ---
JOB  fill_13085   timewalk.sub
VARS fill_13085   args_file="/afs/cern.ch/work/i/idioniso/snd-veto-us/htcondor/timewalk/dag_args/parts_run13085.txt"
RETRY fill_13085  2

JOB  merge_13085  merge_single_run.sub
VARS merge_13085  run="13085" category="catIII"
RETRY merge_13085 2

JOB  fit_13085    fit_single_run.sub
VARS fit_13085    run="13085"
RETRY fit_13085   2

PARENT fill_13085 CHILD merge_13085
PARENT merge_13085 CHILD fit_13085

