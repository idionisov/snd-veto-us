#!/bin/bash

sw="sw-vetoUS"
tag="latest-vetoUS-upstream-work-release"
stack="2025/Oct7"

while getopts ":v:t:s:h" opt; do
  case ${opt} in
    v )
      sw="${OPTARG}"
      ;;
    t )
      tag="${OPTARG}"
      ;;
    s )
      stack="${OPTARG}"
      ;;
    h )
      printf "Usage: %s [-v sw_version] [-t tag] [-s stack]\n" "$(basename "$0")"
      printf "\nFlags:\n"
      printf "  -v    Software root version (default: sw)\n"
      printf "  -t    Release tag (default: latest-master-release)\n"
      printf "  -s    CVMFS stack path (default: 2025/Oct7)\n"
      exit 0
      ;;
    \? )
      printf "Invalid option: %s\n" "-${OPTARG}" >&2
      exit 1
      ;;
    : )
      printf "Option -%s requires an argument.\n" "${OPTARG}" >&2
      exit 1
      ;;
  esac
done

cvmfsHome="/cvmfs/sndlhc.cern.ch/SNDLHC-${stack}"

if ! alienv query | grep -q "ALICE@sndsw::latest <L>" && ! alienv unload "sndsw/latest" 2>/dev/null | grep -q 'sndsw/master'; then 

    # Check if it's sourced and source it if it isn't
    if ! printenv | grep -q SNDSW_VERSION=master; then
        source ${cvmfsHome}/setUp.sh &> /dev/null
    fi

    alienv enter --shellrc -w "${SND_HOME}/${sw}" sndsw/"${tag}"

else

    # If it's already loaded, print it out
    printf "\e[1;31m==>\e[1;3;39m Already in an sndsw environment!\n\e[0m"
fi

